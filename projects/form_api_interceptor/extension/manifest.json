{
  "manifest_version": 3,
  "name": "Form & Universal API Harvester — ดักจับ API ทั้งหมด & ถอดฟอร์มสร้างบอทอัตโนมัติ",
  "short_name": "FormAPIHarvester",
  "version": "1.2.0",
  "description": "ดักจับ Network API ทุกชนิดในเว็บ (GET/POST/Fetch/XHR) พร้อมระบบแยกแยะฟอร์มอัจฉริยะ (Smart Form Tagging) บันทึก DOM ทุกฟิลด์เพื่อสร้างบอทอัตโนมัติ",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Form & API Interceptor Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/inject-interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ]
}
