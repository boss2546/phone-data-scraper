{
  "manifest_version": 3,
  "name": "Universal Media Grabber — โหลดภาพ & วิดีโอมาตรฐาน (PNG/JPG/MP4)",
  "short_name": "MediaGrabber",
  "version": "1.0.0",
  "description": "วางเมาส์เหนือภาพหรือวิดีโอบนเว็บไซต์เพื่อดาวน์โหลดทันที แปลงนามสกุลแปลก (.webp, .avif, .svg, .webm, blob) เป็น .png, .jpg และ .mp4 อัตโนมัติ",
  "permissions": [
    "storage",
    "downloads",
    "contextMenus",
    "tabs",
    "scripting",
    "sidePanel",
    "offscreen",
    "notifications",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Universal Media Grabber (PNG / JPG / MP4)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
