# ==============================================================================
# 🚢 VesselFinder Live Maritime Radar Microservice - Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=8088
HOST=0.0.0.0

# AIS Radar Background Auto-Sweep Interval (in seconds)
# Recommended: 120 (2 minutes) for real-time coastal radar
RADAR_REFRESH_INTERVAL=120

# Default Maritime Area (thailand_all_seas, gulf_of_thailand_all, andaman_th)
DEFAULT_ZONE=thailand_all_seas

# Photo Harvester Concurrency
HARVEST_MAX_WORKERS=8

